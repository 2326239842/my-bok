# HTML — 短期缓存 + stale-while-revalidate
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Service Worker 不缓存——让新版 SW（v4）能尽快被所有浏览器拉取接管，避免旧缓存残留
/sw.js
  Cache-Control: no-cache

# Content JSON — 短期缓存（文章更新频繁，缩短缓存让更新后刷新即见）
/articles-content.json
  Cache-Control: public, max-age=60, stale-while-revalidate=600
  X-Content-Type-Options: nosniff

# 连连看游戏 — 允许同源 iframe 嵌入（CSP frame-ancestors 优先于 X-Frame-Options）
/linkup/*
  Content-Security-Policy: frame-ancestors 'self'

# 静态资源 — 长期缓存
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# 音乐文件 — 长期缓存 + 支持流式播放（Range 请求）
/music/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  Accept-Ranges: bytes

# Prism 本地资源 — 长期缓存
/assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# robots.txt / sitemap.xml — 中期缓存
/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

# APK 下载 — 正确 MIME + 附件下载 + 短缓存
/downloads/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment
  Cache-Control: public, max-age=3600
